<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/viewRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_10x"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblTicketNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="2"
            android:padding="@dimen/dimen_1x"
            android:text="01"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/text_size_xxxlarge" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/dividerColor" />

        <TextView
            android:id="@+id/lblPatientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:gravity="center_vertical"
            android:ellipsize="end"
            android:padding="@dimen/dimen_2x"
            android:marqueeRepeatLimit="marquee_forever"
            android:lines="1"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/text_size_xhuge" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/dividerColor" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3">

            <TextView
                android:id="@+id/lblStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_centerInParent="true"
                android:text="Dang kham"
                android:padding="@dimen/dimen_1x"
                android:textColor="@color/textColorSecondary"
                android:textSize="@dimen/text_size_xxxlarge" />

            <pl.droidsonroids.gif.GifImageView
                android:id="@+id/imgDangKhamStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                />

        </RelativeLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_divider"
        android:background="@color/dividerColor" />
</LinearLayout>
