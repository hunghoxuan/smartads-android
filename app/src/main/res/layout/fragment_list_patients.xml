<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/viewHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_8x"
        android:gravity="center"
        android:background="@color/colorPrimary"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lblRoomNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:ellipsize="end"
            android:padding="@dimen/dimen_1x"
            android:lines="1"
            android:text=""
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_xxxlarge" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/viewListHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_8x"
        android:background="@color/dividerColor"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblTicketNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="2"
            android:padding="@dimen/dimen_1x"
            android:text="@string/ticket_no"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/text_size_xxlarge" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/dividerColor" />

        <TextView
            android:id="@+id/lblPatientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:gravity="center"
            android:ellipsize="end"
            android:padding="@dimen/dimen_1x"
            android:marqueeRepeatLimit="marquee_forever"
            android:lines="1"
            android:text="@string/patient_name"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/text_size_xxlarge" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/dividerColor" />

        <TextView
            android:id="@+id/lblStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="3"
            android:ellipsize="end"
            android:maxLines="4"
            android:text="@string/status"
            android:padding="@dimen/dimen_1x"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/text_size_xxlarge" />

    </LinearLayout>

    <ListView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/lsvPatients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="0dp"
        android:divider="@null"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/viewBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_6x"
        android:gravity="center_horizontal"
        android:background="@color/black"
        android:orientation="vertical"/>


</LinearLayout>


